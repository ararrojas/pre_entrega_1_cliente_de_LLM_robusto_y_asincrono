# Proveedor a usar por defecto en main.py: "openai", "anthropic" o "gemini"
LLM_PROVIDER=gemini

# Modelo a usar según el proveedor, por ejemplo:
#   openai    -> gpt-4o-mini
#   anthropic -> claude-3-5-sonnet-20241022
#   gemini    -> gemini-2.5-flash
LLM_MODEL=gemini-2.5-flash

# Completá solo la clave del proveedor que vayas a usar
# (nunca subas este archivo con valores reales; .env ya está en .gitignore)
OPENAI_API_KEY=sk-...
ANTHROPIC_API_KEY=sk-ant-...
GEMINI_API_KEY=...
